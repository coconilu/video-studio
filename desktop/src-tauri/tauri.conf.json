{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Studio",
  "version": "0.1.1",
  "identifier": "com.coconilu.video-studio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Video Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1080,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "resources": [
      "resources/README.txt",
      "resources/node/",
      "resources/platform/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxRUE3MUNENDA3NTYzQTUKUldTbFkzVkF6WEhxSWJ5R0NKZUM1aXdQMXl4OHpXVjhoTEZaWUlWN3AwaEdxOHNiZWx1aHMrZHQK",
      "endpoints": [
        "https://github.com/coconilu/video-studio/releases/latest/download/latest.json"
      ]
    }
  }
}
